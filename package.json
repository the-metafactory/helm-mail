{
  "name": "helm-mail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mail capabilities for Helm and a Desk adapter, generic over a versioned mail connection interface.",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "conformance": "bun run src/conformance-cli.ts",
    "build:adapter": "bun scripts/build-adapter.ts",
    "check:adapter": "bun scripts/build-adapter.ts --check",
    "probe:read": "bun scripts/probe-read.ts",
    "typecheck": "bunx tsc --noEmit",
    "build:actions": "bun scripts/build-actions.ts",
    "check:actions": "bun scripts/build-actions.ts --check",
    "probe:reply": "bun scripts/probe-reply.ts"
  },
  "devDependencies": {
    "@the-metafactory/cortex": "https://codeload.github.com/the-metafactory/cortex/tar.gz/refs/tags/v6.32.0",
    "@types/bun": "latest"
  }
}
